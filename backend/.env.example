# Copy to backend/.env for local (non-Docker) development.
# Docker Compose overrides DATABASE_URL / REDIS_URL with container hostnames.

NODE_ENV=development
PORT=3000

# Also read by /db (Prisma CLI) — single source of truth for local dev.
DATABASE_URL=postgresql://prep:prep@localhost:5432/interview_prep?schema=public
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ── Auth ──
# Access-token signing key (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production
COOKIE_SECURE=false
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# ── Object storage (S3-compatible) ──
# Defaults match the MinIO service in docker-compose.yml. For AWS S3, omit
# S3_ENDPOINT/S3_PUBLIC_ENDPOINT and set real credentials (or use an IAM role).
S3_ENDPOINT=http://localhost:9000
# Endpoint the browser uses for presigned file URLs (only if it differs)
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=interview-prep
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_PRESIGNED_URL_TTL_SECONDS=3600

# ── Mail (SMTP via Nodemailer, queued with BullMQ) ──
# log  = print emails to the backend log (dev only; codes visible)
# smtp = send for real. Examples:
#   SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<SendGrid API key>
#   AWS SES:  SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587 SMTP_USER/SMTP_PASS=<SES SMTP credentials>
#   Mailpit (docker compose): SMTP_HOST=localhost SMTP_PORT=1025
MAIL_TRANSPORT=log
# SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="InterviewPrep <no-reply@interviewprep.local>"
# MAIL_REPLY_TO=support@yourdomain.com
APP_BASE_URL=http://localhost:5173
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_BASE_DELAY_MS=10000
MAIL_WORKER_ENABLED=true

# ── Exams (FRD §4.6) ──
# Runtime autosave cadence; a gap longer than the grace counts as a disconnection
# (grace must be >= 2x the autosave interval).
EXAM_AUTOSAVE_INTERVAL_SECONDS=15
EXAM_OFFLINE_GRACE_SECONDS=45
# Pause-on-disconnect attempts not resumed within this are auto-submitted.
EXAM_ABANDON_AFTER_HOURS=24
EXAM_SWEEPER_ENABLED=true
EXAM_SWEEP_INTERVAL_SECONDS=60
# "Run code" against sample tests. disabled = shows "not available" (until the
# Step 8 judge); local = unsandboxed JS/Python child processes, DEV ONLY
# (refused when NODE_ENV=production).
CODE_RUNNER=disabled
CODE_RUN_COOLDOWN_SECONDS=3
