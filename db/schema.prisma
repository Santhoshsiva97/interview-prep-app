// Interview Prep Portal — database schema.
//
// Conventions (see PROJECT_CONTEXT.md):
//   - UUID primary keys:   id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
//   - Audit columns:       created_at DateTime  @default(now()) @db.Timestamptz(6)
//                          updated_at DateTime  @updatedAt @db.Timestamptz(6)
//                          deleted_at DateTime? @db.Timestamptz(6)   (soft delete)
//   - snake_case tables/columns via @@map / @map, camelCase in TypeScript
//   - Money as integer minor units (Int / BigInt), never Float/Decimal
//
// NOTE: Step 2 (Auth) was built before Step 1, so the Identity & Access models
// below are a minimal version. Step 1 reconciles them with the Database Module
// Design Document.

generator client {
  provider            = "prisma-client"
  output              = "../backend/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & Access ─────────────────────────────

enum UserRole {
  candidate
  editor
  support
  admin
  super_admin

  @@map("user_role")
}

enum UserStatus {
  pending_verification
  active
  suspended

  @@map("user_status")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String     @db.VarChar(100)
  /// Always stored lower-cased (normalized in the API layer).
  email               String     @unique @db.VarChar(254)
  /// E.164 format, e.g. +919876543210
  phone               String?    @db.VarChar(20)
  /// Null for accounts that only sign in via a social provider.
  passwordHash        String?    @map("password_hash") @db.Text
  role                UserRole   @default(candidate)
  status              UserStatus @default(pending_verification)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  googleId            String?    @unique @map("google_id") @db.VarChar(255)
  /// Set when an admin suspends the account (FRD §4.3); cleared on reactivation.
  suspendedAt         DateTime?  @map("suspended_at") @db.Timestamptz(6)
  suspendedById       String?    @map("suspended_by_id") @db.Uuid
  suspensionReason    String?    @map("suspension_reason") @db.VarChar(500)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  profile       UserProfile?
  mailMessages  MailMessage[]

  authoredQuestions  Question[]        @relation("QuestionAuthor")
  submittedQuestions Question[]        @relation("QuestionSubmitter")
  reviewedQuestions  Question[]        @relation("QuestionReviewer")
  questionVersions   QuestionVersion[]
  questionImports    QuestionImport[]
  suspendedBy        User?             @relation("UserSuspensions", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers     User[]            @relation("UserSuspensions")
  examsCreated       Exam[]            @relation("ExamCreator")
  examsUpdated       Exam[]            @relation("ExamUpdater")
  examsPublished     Exam[]            @relation("ExamPublisher")
  examSessions       ExamSession[]
  codeSubmissions    CodeSubmission[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Candidate-editable profile details (FRD §4.2), 1:1 with users. Created lazily
/// on first edit/upload. Files live in S3-compatible storage; only object keys
/// are stored here.
model UserProfile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  headline         String?   @db.VarChar(120)
  bio              String?   @db.VarChar(1000)
  location         String?   @db.VarChar(100)
  targetRole       String?   @map("target_role") @db.VarChar(100)
  experienceYears  Int?      @map("experience_years") @db.SmallInt
  linkedinUrl      String?   @map("linkedin_url") @db.VarChar(255)
  githubUrl        String?   @map("github_url") @db.VarChar(255)
  avatarKey        String?   @map("avatar_key") @db.VarChar(512)
  resumeKey        String?   @map("resume_key") @db.VarChar(512)
  resumeFileName   String?   @map("resume_file_name") @db.VarChar(255)
  resumeSizeBytes  Int?      @map("resume_size_bytes")
  resumeUploadedAt DateTime? @map("resume_uploaded_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// One row per issued refresh token. Rotation: each use revokes the row and
/// issues a new one in the same family; reuse of a revoked token revokes the
/// whole family (stolen-token detection).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque token; the raw value only ever lives in the cookie.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────── Platform: Mail ───────────────────────────────

enum MailStatus {
  queued
  sending
  retrying
  sent
  failed

  @@map("mail_status")
}

/// One row per outbound email (FRD §4.5): the delivery-status log. Message
/// bodies are rendered from `template` at send time and never stored (they can
/// contain one-time codes).
model MailMessage {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?    @map("user_id") @db.Uuid
  toAddress         String     @map("to_address") @db.VarChar(254)
  template          String     @db.VarChar(50)
  subject           String     @db.VarChar(255)
  status            MailStatus @default(queued)
  attempts          Int        @default(0)
  maxAttempts       Int        @map("max_attempts")
  providerMessageId String?    @map("provider_message_id") @db.VarChar(255)
  lastError         String?    @map("last_error") @db.VarChar(1000)
  lastAttemptAt     DateTime?  @map("last_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime?  @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([toAddress])
  @@index([userId])
  @@index([createdAt])
  @@map("mail_messages")
}

// ─────────────────────────────── Question Bank ────────────────────────────────
// FRD §4.11. Built ahead of Step 1: reconcile with the Database Module Design Document.

enum QuestionType {
  mcq
  coding

  @@map("question_type")
}

/// Review state of the question's current version. A question can be
/// `draft` while an older version is still live (published_version_id).
enum QuestionStatus {
  draft
  pending_review
  published
  rejected
  archived

  @@map("question_status")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum TagKind {
  skill
  company

  @@map("tag_kind")
}

model Topic {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions Question[]
  versions  QuestionVersion[]

  @@map("topics")
}

model Tag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(60)
  slug      String    @unique @db.VarChar(60)
  kind      TagKind   @default(skill)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions QuestionTag[]

  @@index([kind])
  @@map("tags")
}

/// Stable identity of a question. Content lives in immutable question_versions
/// rows; title/topic/difficulty are mirrored from the current version for
/// listing and filtering.
model Question {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               QuestionType
  status             QuestionStatus @default(draft)
  /// Source identifier from bulk import (e.g. the Content Acquisition Tool); re-imports update in place.
  externalId         String?        @unique @map("external_id") @db.VarChar(120)
  title              String         @db.VarChar(200)
  topicId            String         @map("topic_id") @db.Uuid
  difficulty         Difficulty
  /// Latest version (what editors work on).
  currentVersionId   String?        @unique @map("current_version_id") @db.Uuid
  /// Version candidates see; set when an admin approves. Null = never published / archived.
  publishedVersionId String?        @unique @map("published_version_id") @db.Uuid
  authorId           String?        @map("author_id") @db.Uuid
  submittedAt        DateTime?      @map("submitted_at") @db.Timestamptz(6)
  submittedById      String?        @map("submitted_by_id") @db.Uuid
  reviewedAt         DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewedById       String?        @map("reviewed_by_id") @db.Uuid
  reviewNote         String?        @map("review_note") @db.VarChar(1000)
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  topic            Topic             @relation(fields: [topicId], references: [id])
  currentVersion   QuestionVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  publishedVersion QuestionVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  versions         QuestionVersion[] @relation("QuestionVersions")
  tags             QuestionTag[]
  author           User?             @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submittedBy      User?             @relation("QuestionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("QuestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  examItems        ExamItem[]
  sessionItems     ExamSessionItem[]

  @@index([status])
  @@index([type])
  @@index([topicId])
  @@index([difficulty])
  @@index([createdAt])
  @@map("questions")
}

/// Immutable snapshot of a question's content. Every edit adds a row.
model QuestionVersion {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId    String     @map("question_id") @db.Uuid
  versionNumber Int        @map("version_number")
  title         String     @db.VarChar(200)
  /// Markdown.
  body          String     @db.Text
  difficulty    Difficulty
  topicId       String     @map("topic_id") @db.Uuid
  explanation   String?    @db.Text
  marks         Int        @default(1)
  /// Type-specific payload: { mcq: { options, allowMultiple } } or
  /// { coding: { timeLimitMs, memoryLimitMb, starterCode, testCases } }.
  content       Json
  changeNote    String?    @map("change_note") @db.VarChar(500)
  createdById   String?    @map("created_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)

  question     Question          @relation("QuestionVersions", fields: [questionId], references: [id], onDelete: Cascade)
  topic        Topic             @relation(fields: [topicId], references: [id])
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  currentOf    Question?         @relation("CurrentVersion")
  publishedOf  Question?         @relation("PublishedVersion")
  examItems    ExamItem[]        @relation("ExamItemVersion")
  sessionItems ExamSessionItem[] @relation("SessionItemVersion")

  @@unique([questionId, versionNumber])
  @@map("question_versions")
}

/// Link table with a composite key (deviation from the all-UUID-PK
/// convention, as is standard for pure join tables).
model QuestionTag {
  questionId String   @map("question_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

/// History of bulk uploads (dry runs are not stored).
model QuestionImport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedById   String?   @map("uploaded_by_id") @db.Uuid
  fileName       String    @map("file_name") @db.VarChar(255)
  format         String    @db.VarChar(10)
  totalRows      Int       @map("total_rows")
  createdCount   Int       @map("created_count")
  updatedCount   Int       @map("updated_count")
  unchangedCount Int       @map("unchanged_count")
  errorCount     Int       @map("error_count")
  /// Per-row problems: [{ row, externalId?, errors: [{ field, message }] }].
  errors         Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("question_imports")
}

// ───────────────────────────── Exams & Sessions ──────────────────────────────
// FRD §4.6 (Virtual Interview & Exam Module). Built ahead of Step 1: reconcile
// with the Database Module Design Document.

enum ExamKind {
  mock_exam
  virtual_interview

  @@map("exam_kind")
}

enum ExamStatus {
  draft
  published
  archived

  @@map("exam_status")
}

/// Exam / interview template built by staff. Structure: exam → sections → items.
model Exam {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String     @db.VarChar(200)
  kind              ExamKind   @default(mock_exam)
  status            ExamStatus @default(draft)
  /// Short summary shown in the catalog.
  description       String?    @db.VarChar(1000)
  /// Markdown shown on the pre-test instructions/consent screen.
  instructions      String     @db.Text
  /// Total time. When `sectionTimed`, always the sum of the section limits.
  durationMinutes   Int        @map("duration_minutes")
  /// Sections run in order, each on its own clock; finished sections lock.
  sectionTimed      Boolean    @default(false) @map("section_timed")
  /// true: time offline (beyond a short grace) isn't charged, so a dropped
  /// connection resumes with the saved remaining time. false: the clock keeps running.
  pauseOnDisconnect Boolean    @default(true) @map("pause_on_disconnect")
  shuffleQuestions  Boolean    @default(false) @map("shuffle_questions")
  shuffleOptions    Boolean    @default(false) @map("shuffle_options")
  /// Null = unlimited attempts.
  maxAttempts       Int?       @map("max_attempts")
  /// Pass mark as a percentage of total marks (used by scorecards, Step 9).
  passPercent       Int?       @map("pass_percent") @db.SmallInt
  createdById       String?    @map("created_by_id") @db.Uuid
  updatedById       String?    @map("updated_by_id") @db.Uuid
  publishedAt       DateTime?  @map("published_at") @db.Timestamptz(6)
  publishedById     String?    @map("published_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sections    ExamSection[]
  sessions    ExamSession[]
  createdBy   User?         @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("ExamUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedBy User?         @relation("ExamPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([status, kind])
  @@index([createdAt])
  @@map("exams")
}

/// A section and its marking scheme.
model ExamSection {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId              String    @map("exam_id") @db.Uuid
  position            Int
  title               String    @db.VarChar(120)
  description         String?   @db.VarChar(1000)
  /// Required when the exam is section-timed; ignored otherwise.
  durationMinutes     Int?      @map("duration_minutes")
  /// Overrides each question's own marks. Null = use the question's marks.
  marksPerQuestion    Int?      @map("marks_per_question")
  /// A wrong MCQ answer deducts this % of the question's marks (0 = no negative marking).
  negativeMarkPercent Int       @default(0) @map("negative_mark_percent") @db.SmallInt
  /// Allow partial credit (coding: by passed test-case weight; multi-answer MCQ:
  /// by options). Off = all-or-nothing. Applied by the grader (Step 8).
  partialScoring      Boolean   @default(true) @map("partial_scoring")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  exam  Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  items ExamItem[]

  @@unique([examId, position])
  @@map("exam_sections")
}

/// A question placed in a section. `questionVersionId` pins the version candidates
/// get: the question's live version when the exam was last saved.
model ExamItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId         String    @map("section_id") @db.Uuid
  position          Int
  questionId        String    @map("question_id") @db.Uuid
  /// Null while the question has no live version (the exam can't be published then).
  questionVersionId String?   @map("question_version_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  section         ExamSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion? @relation("ExamItemVersion", fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@unique([sectionId, position])
  @@index([questionId])
  @@map("exam_items")
}

enum ExamSessionStatus {
  in_progress
  submitted

  @@map("exam_session_status")
}

enum ExamSubmitReason {
  /// The candidate clicked Submit.
  manual
  /// The clock ran out (client auto-submit, or detected by the server).
  time_expired
  /// Pause-on-disconnect session not resumed within EXAM_ABANDON_AFTER_HOURS.
  abandoned

  @@map("exam_submit_reason")
}

/// One attempt at an exam. Self-contained: sections and items are copied from
/// the exam at start, so editing the exam never changes a running attempt.
/// Timing is server-authoritative (see exam-clock.ts in the exams module).
model ExamSession {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId              String            @map("exam_id") @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  attemptNumber       Int               @map("attempt_number")
  status              ExamSessionStatus @default(in_progress)
  consentedAt         DateTime          @map("consented_at") @db.Timestamptz(6)
  startedAt           DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Total time left, as of `lastSyncedAt`.
  timeRemainingMs     Int               @map("time_remaining_ms")
  /// Section-timed exams only: time left in the current section, as of `lastSyncedAt`.
  sectionRemainingMs  Int?              @map("section_remaining_ms")
  currentSectionIndex Int               @default(0) @map("current_section_index")
  /// Last server contact (start, resume or autosave); the clock is charged from here.
  lastSyncedAt        DateTime          @map("last_synced_at") @db.Timestamptz(6)
  submittedAt         DateTime?         @map("submitted_at") @db.Timestamptz(6)
  submitReason        ExamSubmitReason? @map("submit_reason")
  /// Set to `pending` on submit; the judge worker grades it (FRD §4.7).
  gradingStatus       GradingStatus?    @map("grading_status")
  /// Total score in hundredths of a mark (can be negative with negative marking).
  scoreCenti          Int?              @map("score_centi")
  gradedAt            DateTime?         @map("graded_at") @db.Timestamptz(6)
  gradingError        String?           @map("grading_error") @db.VarChar(1000)
  /// Exam settings and sections as they were at start: { settings, sections[] }.
  snapshot            Json
  totalMarks          Int               @map("total_marks")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(6)

  exam            Exam               @relation(fields: [examId], references: [id], onDelete: Restrict)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           ExamSessionItem[]
  codeSubmissions CodeSubmission[]
  events          ExamSessionEvent[]

  @@unique([userId, examId, attemptNumber])
  @@index([userId, status])
  @@index([examId])
  @@index([status, lastSyncedAt])
  @@map("exam_sessions")
}

/// A question in a session, in the order the candidate sees it, plus their answer.
model ExamSessionItem {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String       @map("session_id") @db.Uuid
  sectionIndex        Int          @map("section_index")
  position            Int
  questionId          String       @map("question_id") @db.Uuid
  questionVersionId   String       @map("question_version_id") @db.Uuid
  type                QuestionType
  /// Marks for a fully correct answer (section override or the question's own).
  marks               Int
  negativeMarkPercent Int          @map("negative_mark_percent") @db.SmallInt
  partialScoring      Boolean      @map("partial_scoring")
  /// MCQ: option ids in display order (shuffled when the exam says so).
  optionOrder         Json?        @map("option_order")
  /// MCQ `{ optionIds }` or coding `{ language, sources: { [language]: code } }`. Null = unanswered.
  response            Json?
  markedForReview     Boolean      @default(false) @map("marked_for_review")
  visitedAt           DateTime?    @map("visited_at") @db.Timestamptz(6)
  answeredAt          DateTime?    @map("answered_at") @db.Timestamptz(6)
  timeSpentMs         Int          @default(0) @map("time_spent_ms")
  /// Grading result: score in hundredths of a mark, and how the answer fared.
  scoreCenti          Int?         @map("score_centi")
  outcome             ItemOutcome?
  gradedAt            DateTime?    @map("graded_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)

  session         ExamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeSubmissions CodeSubmission[]
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion  @relation("SessionItemVersion", fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, sectionIndex, position])
  @@map("exam_session_items")
}

/// Session lifecycle log (started, resumed, section_advanced, submitted, …).
/// Proctoring (Step 14) appends its own event types here.
model ExamSessionEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  type      String    @db.VarChar(40)
  data      Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("exam_session_events")
}

// ───────────────────────────── Evaluation & Judge ─────────────────────────────
// FRD §4.7. Built ahead of Step 1: reconcile with the Database Module Design Document.

enum GradingStatus {
  pending
  grading
  graded
  failed

  @@map("grading_status")
}

enum ItemOutcome {
  correct
  partial
  incorrect
  unanswered

  @@map("item_outcome")
}

/// Per-test-case / overall verdict: Accepted, Wrong Answer, Time/Memory Limit
/// Exceeded, Runtime Error, Compilation Error, Internal (judge) Error.
enum TestVerdict {
  AC
  WA
  TLE
  MLE
  RE
  CE
  IE

  @@map("test_verdict")
}

enum CodeSubmissionKind {
  /// Candidate pressed "Run": sample tests only, not graded.
  run
  /// Grading a submitted answer: sample + hidden tests.
  grade

  @@map("code_submission_kind")
}

enum CodeSubmissionStatus {
  queued
  running
  completed
  failed

  @@map("code_submission_status")
}

/// One execution of candidate code against a question's test cases.
model CodeSubmission {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String               @map("session_id") @db.Uuid
  sessionItemId String               @map("session_item_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  kind          CodeSubmissionKind
  status        CodeSubmissionStatus @default(queued)
  language      String               @db.VarChar(20)
  source        String               @db.Text
  /// Overall verdict: AC only if every test passed, else the first failing test's verdict.
  verdict       TestVerdict?
  passedCount   Int?                 @map("passed_count")
  totalCount    Int?                 @map("total_count")
  passedWeight  Int?                 @map("passed_weight")
  totalWeight   Int?                 @map("total_weight")
  compileOutput String?              @map("compile_output") @db.Text
  /// Per test case: [{ index, isSample, verdict, timeMs, memoryKb, stdout, stderr }] (outputs truncated).
  /// Hidden-test outputs are for staff only; candidates only ever see sample outputs.
  results       Json?
  /// Why it couldn't be judged (judge down, unsupported language…).
  error         String?              @db.VarChar(1000)
  attempts      Int                  @default(0)
  startedAt     DateTime?            @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?            @map("finished_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(6)

  session     ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionItem ExamSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, kind])
  @@index([sessionItemId, createdAt])
  @@index([status])
  @@map("code_submissions")
}
