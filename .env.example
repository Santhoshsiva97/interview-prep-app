# Optional overrides for docker-compose.yml (copy to .env in the repo root).
# Defaults shown; change them if the ports clash with services on your machine.
POSTGRES_USER=prep
POSTGRES_PASSWORD=prep
POSTGRES_DB=interview_prep
POSTGRES_PORT=5432
REDIS_PORT=6379

# Access-token signing key for the backend container (>= 32 chars)
# JWT_ACCESS_SECRET=

# MinIO (S3-compatible storage) credentials and ports
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# Mailpit (local SMTP catcher) ports
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
