// Interview Prep Portal — database schema.
//
// Conventions (see PROJECT_CONTEXT.md):
//   - UUID primary keys:   id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
//   - Audit columns:       created_at DateTime  @default(now()) @db.Timestamptz(6)
//                          updated_at DateTime  @updatedAt @db.Timestamptz(6)
//                          deleted_at DateTime? @db.Timestamptz(6)   (soft delete)
//   - snake_case tables/columns via @@map / @map, camelCase in TypeScript
//   - Money as integer minor units (Int / BigInt), never Float/Decimal
//
// NOTE: Step 2 (Auth) was built before Step 1, so the Identity & Access models
// below are a minimal version. Step 1 reconciles them with the Database Module
// Design Document.

generator client {
  provider            = "prisma-client"
  output              = "../backend/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & Access ─────────────────────────────

enum UserRole {
  candidate
  editor
  support
  admin
  super_admin

  @@map("user_role")
}

enum UserStatus {
  pending_verification
  active
  suspended

  @@map("user_status")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String     @db.VarChar(100)
  /// Always stored lower-cased (normalized in the API layer).
  email               String     @unique @db.VarChar(254)
  /// E.164 format, e.g. +919876543210
  phone               String?    @db.VarChar(20)
  /// Null for accounts that only sign in via a social provider.
  passwordHash        String?    @map("password_hash") @db.Text
  role                UserRole   @default(candidate)
  status              UserStatus @default(pending_verification)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  googleId            String?    @unique @map("google_id") @db.VarChar(255)
  /// Set when an admin suspends the account (FRD §4.3); cleared on reactivation.
  suspendedAt         DateTime?  @map("suspended_at") @db.Timestamptz(6)
  suspendedById       String?    @map("suspended_by_id") @db.Uuid
  suspensionReason    String?    @map("suspension_reason") @db.VarChar(500)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  profile       UserProfile?
  mailMessages  MailMessage[]

  authoredQuestions  Question[]        @relation("QuestionAuthor")
  submittedQuestions Question[]        @relation("QuestionSubmitter")
  reviewedQuestions  Question[]        @relation("QuestionReviewer")
  questionVersions   QuestionVersion[]
  questionImports    QuestionImport[]
  suspendedBy        User?             @relation("UserSuspensions", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers     User[]            @relation("UserSuspensions")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Candidate-editable profile details (FRD §4.2), 1:1 with users. Created lazily
/// on first edit/upload. Files live in S3-compatible storage; only object keys
/// are stored here.
model UserProfile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  headline         String?   @db.VarChar(120)
  bio              String?   @db.VarChar(1000)
  location         String?   @db.VarChar(100)
  targetRole       String?   @map("target_role") @db.VarChar(100)
  experienceYears  Int?      @map("experience_years") @db.SmallInt
  linkedinUrl      String?   @map("linkedin_url") @db.VarChar(255)
  githubUrl        String?   @map("github_url") @db.VarChar(255)
  avatarKey        String?   @map("avatar_key") @db.VarChar(512)
  resumeKey        String?   @map("resume_key") @db.VarChar(512)
  resumeFileName   String?   @map("resume_file_name") @db.VarChar(255)
  resumeSizeBytes  Int?      @map("resume_size_bytes")
  resumeUploadedAt DateTime? @map("resume_uploaded_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// One row per issued refresh token. Rotation: each use revokes the row and
/// issues a new one in the same family; reuse of a revoked token revokes the
/// whole family (stolen-token detection).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque token; the raw value only ever lives in the cookie.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────── Platform: Mail ───────────────────────────────

enum MailStatus {
  queued
  sending
  retrying
  sent
  failed

  @@map("mail_status")
}

/// One row per outbound email (FRD §4.5): the delivery-status log. Message
/// bodies are rendered from `template` at send time and never stored (they can
/// contain one-time codes).
model MailMessage {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?    @map("user_id") @db.Uuid
  toAddress         String     @map("to_address") @db.VarChar(254)
  template          String     @db.VarChar(50)
  subject           String     @db.VarChar(255)
  status            MailStatus @default(queued)
  attempts          Int        @default(0)
  maxAttempts       Int        @map("max_attempts")
  providerMessageId String?    @map("provider_message_id") @db.VarChar(255)
  lastError         String?    @map("last_error") @db.VarChar(1000)
  lastAttemptAt     DateTime?  @map("last_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime?  @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([toAddress])
  @@index([userId])
  @@index([createdAt])
  @@map("mail_messages")
}

// ─────────────────────────────── Question Bank ────────────────────────────────
// FRD §4.11. Built ahead of Step 1: reconcile with the Database Module Design Document.

enum QuestionType {
  mcq
  coding

  @@map("question_type")
}

/// Review state of the question's current version. A question can be
/// `draft` while an older version is still live (published_version_id).
enum QuestionStatus {
  draft
  pending_review
  published
  rejected
  archived

  @@map("question_status")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum TagKind {
  skill
  company

  @@map("tag_kind")
}

model Topic {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions Question[]
  versions  QuestionVersion[]

  @@map("topics")
}

model Tag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(60)
  slug      String    @unique @db.VarChar(60)
  kind      TagKind   @default(skill)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions QuestionTag[]

  @@index([kind])
  @@map("tags")
}

/// Stable identity of a question. Content lives in immutable question_versions
/// rows; title/topic/difficulty are mirrored from the current version for
/// listing and filtering.
model Question {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               QuestionType
  status             QuestionStatus @default(draft)
  /// Source identifier from bulk import (e.g. the Content Acquisition Tool); re-imports update in place.
  externalId         String?        @unique @map("external_id") @db.VarChar(120)
  title              String         @db.VarChar(200)
  topicId            String         @map("topic_id") @db.Uuid
  difficulty         Difficulty
  /// Latest version (what editors work on).
  currentVersionId   String?        @unique @map("current_version_id") @db.Uuid
  /// Version candidates see; set when an admin approves. Null = never published / archived.
  publishedVersionId String?        @unique @map("published_version_id") @db.Uuid
  authorId           String?        @map("author_id") @db.Uuid
  submittedAt        DateTime?      @map("submitted_at") @db.Timestamptz(6)
  submittedById      String?        @map("submitted_by_id") @db.Uuid
  reviewedAt         DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewedById       String?        @map("reviewed_by_id") @db.Uuid
  reviewNote         String?        @map("review_note") @db.VarChar(1000)
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  topic            Topic             @relation(fields: [topicId], references: [id])
  currentVersion   QuestionVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  publishedVersion QuestionVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  versions         QuestionVersion[] @relation("QuestionVersions")
  tags             QuestionTag[]
  author           User?             @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submittedBy      User?             @relation("QuestionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("QuestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([topicId])
  @@index([difficulty])
  @@index([createdAt])
  @@map("questions")
}

/// Immutable snapshot of a question's content. Every edit adds a row.
model QuestionVersion {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId    String     @map("question_id") @db.Uuid
  versionNumber Int        @map("version_number")
  title         String     @db.VarChar(200)
  /// Markdown.
  body          String     @db.Text
  difficulty    Difficulty
  topicId       String     @map("topic_id") @db.Uuid
  explanation   String?    @db.Text
  marks         Int        @default(1)
  /// Type-specific payload: { mcq: { options, allowMultiple } } or
  /// { coding: { timeLimitMs, memoryLimitMb, starterCode, testCases } }.
  content       Json
  changeNote    String?    @map("change_note") @db.VarChar(500)
  createdById   String?    @map("created_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)

  question    Question  @relation("QuestionVersions", fields: [questionId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id])
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  currentOf   Question? @relation("CurrentVersion")
  publishedOf Question? @relation("PublishedVersion")

  @@unique([questionId, versionNumber])
  @@map("question_versions")
}

/// Link table with a composite key (deviation from the all-UUID-PK
/// convention, as is standard for pure join tables).
model QuestionTag {
  questionId String   @map("question_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

/// History of bulk uploads (dry runs are not stored).
model QuestionImport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedById   String?   @map("uploaded_by_id") @db.Uuid
  fileName       String    @map("file_name") @db.VarChar(255)
  format         String    @db.VarChar(10)
  totalRows      Int       @map("total_rows")
  createdCount   Int       @map("created_count")
  updatedCount   Int       @map("updated_count")
  unchangedCount Int       @map("unchanged_count")
  errorCount     Int       @map("error_count")
  /// Per-row problems: [{ row, externalId?, errors: [{ field, message }] }].
  errors         Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("question_imports")
}
