# Optional. Copy to frontend/.env.local to override.

# Base URL the browser uses for API calls. Defaults to /api/v1 (same origin,
# proxied to the backend by the Vite dev server).
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api requests. Defaults to http://localhost:3000.
# VITE_PROXY_TARGET=http://localhost:3000
